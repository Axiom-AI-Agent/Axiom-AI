# LLM — chat + guardrail + router + extractor (GPT-4o-mini), merge (Gemini)
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Shared Supabase — same project for AI backend + dashboard team
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=

# Qdrant (Phase 4 — RAG)
QDRANT_URL=
QDRANT_API_KEY=

# Twilio WhatsApp Sandbox (optional — use POST /chat for local dev)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WEBHOOK_URL=
TWILIO_VALIDATE_SIGNATURE=true
MESSAGING_DRY_RUN=true

# Agent runtime — set true to use MCP memory_server subprocess (Week 13 pattern)
AGENT_USE_MCP=false

# Google Drive service account JSON path (Phase 4)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Langfuse — tracing + prompt management
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PROMPT_LABEL=production

# Local dev fallback tenant (never use in production paths)
DEV_TENANT_ID=tenant-demo-physics
