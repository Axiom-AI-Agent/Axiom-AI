# LLM — OpenAI (chat/router/guardrail/embeddings) + Gemini (merge)
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Shared Supabase — same project for AI backend + dashboard team
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=

# Qdrant (Phase 4 — RAG)
QDRANT_URL=
QDRANT_API_KEY=

# Twilio WhatsApp Sandbox (optional — use POST /chat for local dev)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WEBHOOK_URL=
TWILIO_VALIDATE_SIGNATURE=true
MESSAGING_DRY_RUN=true

# MCP — crm + rag + memory by default (Phase 6). Drive subprocess deferred.
MCP_INCLUDE_DRIVE=false

# Agent runtime — MCP subprocesses require Python 3.10+ and langchain-mcp-adapters.
# On Python 3.9 leave false (auto-falls back to in-process tools if true but package missing).
AGENT_USE_MCP=false
# When false, MCP failures and resource agent require MCP clients (production strict mode).
ALLOW_INPROCESS_TOOLS=true

# Google Drive service account JSON path (Phase 4)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Set true to use in-memory Drive mock (local dev without Google credentials)
DRIVE_MOCK=true

# Langfuse — tracing + prompt management (optional for local dev)
# US region: https://us.cloud.langfuse.com  |  EU: https://cloud.langfuse.com
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_PROMPT_LABEL=production

# Python 3.10+ required for langchain-mcp-adapters (full MCP subprocess path)

# Local dev fallback tenant (never use in production paths)
DEV_TENANT_ID=tenant-demo-physics

NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000